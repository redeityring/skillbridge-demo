# ---------------------------------------------------------------------------
# SkillBridge environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and set ONE provider key.
#
# SECURITY: these are server-side variables only. They are read in
# `src/lib/ai/client.ts`, which runs exclusively on the server inside
# `src/app/api/*` route handlers. Never rename them to NEXT_PUBLIC_*, never
# import the AI client from a component, and never commit `.env.local`.
#
# NO KEY IS REQUIRED. Without a provider, SkillBridge runs on its built-in
# local rubric engine, which scores answers deterministically. The header shows
# which engine produced each score.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# RECOMMENDED: OpenRouter, free models only — $0, no credit card
# ---------------------------------------------------------------------------
# 1. Create a key at https://openrouter.ai/keys
# 2. Paste it below.
#
# Out of the box this runs an ordered chain of eight `:free` models. It is a
# chain, not a single model, on purpose:
#
#   * Free variants are rate-limited per minute AND per day. OpenRouter's own
#     docs say different models carry different limits, "so you can share the
#     load that way". Falling through several models multiplies the usable
#     quota.
#   * The models sit on different upstream infrastructure, so one provider
#     having a bad day cannot take the demo down.
#   * Requests use OpenRouter's native `models: [...]` routing, so failover
#     happens inside a single HTTP request.
#
# With no credits ever purchased the chain still gives a few hundred free
# requests a day — far more than a demo or a classroom session needs.
# Check your remaining quota any time: GET https://openrouter.ai/api/v1/key
OPENROUTER_API_KEY=

# Optional: how OpenRouter attributes the traffic in its dashboard.
# OPENROUTER_SITE_URL=https://github.com/your-org/skillbridge
# OPENROUTER_SITE_NAME=SkillBridge

# ---------------------------------------------------------------------------
# Alternatives — a single paid model
# ---------------------------------------------------------------------------
# Recognised automatically, in this order:
# OPENAI_API_KEY=
# CEREBRAS_API_KEY=
# GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Manual override (highest priority — overrides everything above)
# ---------------------------------------------------------------------------
# Set AI_API_KEY with any OpenAI-compatible endpoint.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
#
# AI_MODEL takes one id. AI_MODELS takes a comma-separated fallback chain and
# wins if both are set. An explicit override opts into JSON mode; set
# AI_JSON_MODE=false for endpoints that reject `response_format`.
# AI_MODEL=gpt-4o-mini
# AI_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free
# AI_JSON_MODE=true

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Hard timeout for a single AI call, in milliseconds.
AI_TIMEOUT_MS=15000
